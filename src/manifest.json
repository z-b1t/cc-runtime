{
  "manifest_version": 3,
  "name": "cc-runtime",
  "version": "0.0.1",
  "description": "Chrome Side Panel extension for debugging Cocos Creator V3 runtime",
  "homepage_url": "https://github.com/z-b1t/cc-runtime",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "devtools_page": "devtools.html",
  "web_accessible_resources": [
    {
      "matches": ["<all_urls>"],
      "resources": ["injected.js"]
    }
  ],
  "side_panel": {
    "default_path": "devtool/index.html"
  },
  "action": {
    "default_title": "cc-runtime",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "permissions": ["webNavigation", "sidePanel", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"]
}
